#!/usr/bin/env bash

# Theodo Scan CLI
# Main entry point for the theodo-scan command-line tool

set -e

# Get the directory where the script is located
# Resolve symlinks to find the actual script location
if [ -L "${BASH_SOURCE[0]}" ]; then
    # Script is a symlink, resolve it
    SCRIPT_PATH="$(readlink "${BASH_SOURCE[0]}")"
    # Handle relative symlinks
    if [[ "$SCRIPT_PATH" != /* ]]; then
        SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
        SCRIPT_PATH="$SCRIPT_DIR/$SCRIPT_PATH"
    fi
    SCRIPT_DIR="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)"
else
    # Script is not a symlink
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
fi
CLI_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source utility functions
source "$CLI_ROOT/lib/utils/utils.sh"

# Version
VERSION="1.0.0"

# Show help message
show_help() {
    cat << EOF
Theodo Scan - CLI Tool

Usage:
    theodo-scan <command> [options]

Available Commands:
    init            Initialize configuration file
    scan            Run security scan and generate SBOM
    upload          Upload SBOM to S3
    run             Scan and upload in one step
    hello           Display a hello message
    help            Show this help message
    version         Show version information

Options:
    -h, --help      Show help message
    -v, --version   Show version information

Examples:
    theodo-scan init
    theodo-scan scan
    theodo-scan upload
    theodo-scan run
    theodo-scan hello
    theodo-scan --help

For more information about a specific command:
    theodo-scan <command> --help

EOF
}

# Show version
show_version() {
    echo "theodo-scan version $VERSION"
}

# Main function
main() {
    # Handle no arguments
    if [ $# -eq 0 ]; then
        show_help
        exit 0
    fi

    # Parse command
    COMMAND="$1"
    shift

    case "$COMMAND" in
        init)
            source "$CLI_ROOT/lib/commands/init.sh"
            cmd_init "$@"
            ;;
        hello)
            source "$CLI_ROOT/lib/commands/hello.sh"
            cmd_hello "$@"
            ;;
        scan)
            source "$CLI_ROOT/lib/commands/scan.sh"
            cmd_scan "$@"
            ;;
        upload)
            source "$CLI_ROOT/lib/commands/upload.sh"
            cmd_upload "$@"
            ;;
        run)
            source "$CLI_ROOT/lib/commands/run.sh"
            cmd_run "$@"
            ;;
        help|--help|-h)
            show_help
            ;;
        version|--version|-v)
            show_version
            ;;
        *)
            echo "Error: Unknown command '$COMMAND'"
            echo ""
            echo "Run 'theodo-scan help' for usage information."
            exit 1
            ;;
    esac
}

# Run main function
main "$@"

